diff --git a/src/core/expert_cache_sized_test.cpp b/src/core/expert_cache_sized_test.cpp
new file mode 100644
index 0000000..703c725
--- /dev/null
+++ b/src/core/expert_cache_sized_test.cpp
@@ -0,0 +1,265 @@
+// src/core/expert_cache_sized_test.cpp - capacity-hardening regression for the sized slot table.
+//
+// v0.1.34 already seeds open_sized's per-layer cursors correctly (#369) and disables the sized table under
+// per-layer admission in generate.cpp.  What this file pins down is the LAYER BELOW both fixes: whatever two
+// orders a caller combines, a fill that does not fit its slot must be REFUSED, not silently overrunning the
+// next slot.  Sections:
+//   1. rank-order sizing + per-layer fill (the mismatched pair): the capacity guard must fire - fail loud.
+//   2. assignment-first sizing + per-layer fill: clean.
+//   3. rank-order sizing + global admission: clean (the orders agree; the engine's sized-table path).
+//   4. per-layer with uniform slots < layers: empty ranges admit nothing (refusal), no crash, no overrun.
+//   5. duplicate admit: the same pair maps to the same slot; refilling it verifies.
+//   6. bytes > blob_: refused as a caller error, never silently truncated.
+// Needs one CUDA device (~16 MiB).  Exit 0 = every section behaved as labelled.
+
+#include "strata/core/expert_cache.hpp"
+
+#include <cuda_runtime.h>
+
+#include <algorithm>
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <vector>
+
+using strata::core::ExpertCache;
+using strata::core::kNotResident;
+
+namespace {
+
+constexpr int kLayers = 48;
+constexpr int kExperts = 16;
+constexpr int kSlotsPerLayer = 4;
+constexpr int kSlots = kLayers * kSlotsPerLayer;   // 192
+constexpr int kPairs = 96;
+
+int64_t layer_blob(int layer) { return (layer % 2 == 0) ? 14576 : 18176; }
+
+std::vector<std::pair<int32_t, int32_t>> make_profile() {
+    std::vector<std::pair<int32_t, int32_t>> ranked;
+    ranked.reserve(kPairs);
+    for (int i = 0; i < kPairs; ++i)
+        ranked.emplace_back((int32_t) ((i * 7) % kLayers), (int32_t) ((i * 3) % kExperts));
+    return ranked;
+}
+
+std::vector<int64_t> rank_order_sized(const std::vector<std::pair<int32_t, int32_t>>& profile) {
+    std::vector<int64_t> sized;
+    sized.reserve(kSlots);
+    for (int s = 0; s < kSlots; ++s)
+        sized.push_back(layer_blob(profile[(size_t) (s % profile.size())].first));
+    return sized;
+}
+
+std::vector<int64_t> assignment_first_sized(const std::vector<std::pair<int32_t, int32_t>>& profile) {
+    std::vector<int64_t> sized((size_t) kSlots, -1);
+    std::vector<int32_t> layer_next((size_t) kLayers);
+    for (int l = 0; l < kLayers; ++l) layer_next[(size_t) l] = (int32_t) (l * (kSlots / kLayers));
+    for (const auto& pr : profile) {
+        const int64_t q = kSlots / kLayers;
+        const int64_t lo = (int64_t) pr.first * q;
+        const int64_t hi = (pr.first == kLayers - 1) ? kSlots : lo + q;
+        if ((int64_t) layer_next[(size_t) pr.first] >= hi) break;
+        sized[(size_t) layer_next[(size_t) pr.first]++] = layer_blob(pr.first);
+    }
+    for (int s = 0; s < kSlots; ++s) {
+        if (sized[(size_t) s] < 0) {
+            int64_t layer = (int64_t) s / kSlotsPerLayer;
+            if (layer >= kLayers) layer = kLayers - 1;
+            sized[(size_t) s] = layer_blob((int) layer);
+        }
+    }
+    return sized;
+}
+
+struct Outcome {
+    int filled = 0;
+    int guard_refusals = 0;     // fills refused by the capacity guard (fail-loud) or the bytes>blob_ guard
+    int overlap_slots = 0;
+    bool pair0_ok = false;
+    std::string first_overlap, first_refusal, pair0_err;
+};
+
+Outcome run_fill(const std::vector<int64_t>& sized, const std::vector<std::pair<int32_t, int32_t>>& profile,
+                 bool per_layer) {
+    Outcome o;
+    std::vector<std::vector<uint8_t>> blobs((size_t) kLayers);
+    for (int l = 0; l < kLayers; ++l) blobs[(size_t) l].assign((size_t) layer_blob(l), (uint8_t) (0x10 + l));
+
+    ExpertCache xc;
+    std::string err;
+    if (!xc.open_sized(sized, kLayers, kExperts, err)) {
+        o.first_overlap = std::string("open_sized failed: ") + err;
+        o.overlap_slots = -1;
+        return o;
+    }
+    xc.set_per_layer_admission(per_layer);
+
+    std::vector<std::pair<int32_t, int32_t>> written;   // pairs whose fill succeeded
+    for (const auto& pr : profile) {
+        const int32_t slot = xc.admit(pr.first, pr.second);
+        if (slot == kNotResident) break;
+        if (!xc.fill_slot_blocking(slot, blobs[(size_t) pr.first].data(), err, layer_blob(pr.first))) {
+            if (err.find("refusing") != std::string::npos || err.find("larger than the largest slot") != std::string::npos) {
+                ++o.guard_refusals;
+                if (o.first_refusal.empty()) o.first_refusal = err;
+                continue;    // the guard: this pair stays un-resident-in-bytes; keep draining the rest
+            }
+            o.first_overlap = std::string("fill failed: ") + err;
+            o.overlap_slots = -1;
+            return o;
+        }
+        written.push_back(pr);
+        ++o.filled;
+    }
+
+    for (int s = 0; s < kSlots; ++s) {
+        int owner_layer = -1;
+        bool owner_written = false;
+        for (const auto& pr : profile)
+            if (xc.slot_of(pr.first, pr.second) == s) {
+                owner_layer = pr.first;
+                for (const auto& w : written)
+                    if (w == pr) { owner_written = true; break; }
+                break;
+            }
+        const size_t cap = (size_t) sized[(size_t) s];
+        // a slot whose owner's fill was GUARD-REFUSED was never written: it must read zero.  A written
+        // slot holds its owner's pattern over blob_bytes(owner) and zeros in any capacity padding beyond.
+        std::vector<uint8_t> got(cap, 0xEE), want(cap, 0);
+        if (owner_layer >= 0 && owner_written)
+            std::fill(want.begin(), want.begin() + (size_t) layer_blob(owner_layer), (uint8_t) (0x10 + owner_layer));
+        if (cudaMemcpy(got.data(), xc.device_slot(s), cap, cudaMemcpyDeviceToHost) != cudaSuccess) {
+            o.first_overlap = std::string("D2H failed: ") + cudaGetErrorString(cudaGetLastError());
+            o.overlap_slots = -1;
+            return o;
+        }
+        if (std::memcmp(got.data(), want.data(), cap) != 0) {
+            size_t at = 0;
+            while (at < cap && got[at] == want[at]) ++at;
+            if (o.overlap_slots < 6) {
+                char buf[320];
+                std::snprintf(buf, sizeof buf,
+                    "slot %d owner_layer %d owner_written %d cap %zd first_diff %zd got[diff..]=%02x %02x want=%02x %02x got[tail-8]=%02x want[tail-8]=%02x",
+                    s, owner_layer, (int) owner_written, cap, at,
+                    got[at], at + 1 < cap ? got[at + 1] : 0, want[at], at + 1 < cap ? want[at + 1] : 0,
+                    got[cap - 8], want[cap - 8]);
+                o.first_overlap += std::string(buf) + "\n";
+            }
+            ++o.overlap_slots;
+        }
+    }
+
+    o.pair0_ok = xc.verify_slot(xc.slot_of(profile[0].first, profile[0].second),
+                                blobs[(size_t) profile[0].first].data(), o.pair0_err, layer_blob(profile[0].first));
+    return o;
+}
+
+}  // namespace
+
+int main() {
+    const auto profile = make_profile();
+    int bad = 0;
+
+    std::printf("== 1. rank-order sizing + per-layer fill: the guard must fire (fail loud) ==\n");
+    {
+        const Outcome o = run_fill(rank_order_sized(profile), profile, true);
+        std::printf("filled %d, guard refusals %d, overlap %d, pair-0 %s\n", o.filled, o.guard_refusals,
+                    o.overlap_slots, o.pair0_ok ? "PASS" : "FAIL");
+        if (!o.first_refusal.empty()) std::printf("first refusal: %s\n", o.first_refusal.c_str());
+        if (!o.first_overlap.empty()) std::printf("overlap detail:\n%s", o.first_overlap.c_str());
+        // the mismatched orders must NOT go through silently
+        if (o.guard_refusals == 0 || o.overlap_slots != 0) { std::printf("WRONG: silent path\n"); ++bad; }
+        else std::printf("(refused fills leave dangling residency; those slots read zero - documented API hazard)\n");
+    }
+
+    std::printf("== 2. assignment-first sizing + per-layer fill: clean ==\n");
+    {
+        const Outcome o = run_fill(assignment_first_sized(profile), profile, true);
+        std::printf("filled %d, guard refusals %d, overlap %d, pair-0 %s\n", o.filled, o.guard_refusals,
+                    o.overlap_slots, o.pair0_ok ? "PASS" : "FAIL");
+        if (o.overlap_slots != 0 || !o.pair0_ok || o.guard_refusals != 0) ++bad;
+    }
+
+    std::printf("== 3. rank-order sizing + global admission: clean (the engine's sized path) ==\n");
+    {
+        const Outcome o = run_fill(rank_order_sized(profile), profile, false);
+        std::printf("filled %d, guard refusals %d, overlap %d, pair-0 %s\n", o.filled, o.guard_refusals,
+                    o.overlap_slots, o.pair0_ok ? "PASS" : "FAIL");
+        if (o.overlap_slots != 0 || !o.pair0_ok || o.guard_refusals != 0) ++bad;
+    }
+
+    std::printf("== 4. uniform slots < layers: empty ranges admit nothing, no crash ==\n");
+    {
+        const int few = 10;                       // 10 layers, 4 uniform slots
+        ExpertCache xc;
+        std::string err;
+        std::vector<uint8_t> blob((size_t) 4096, 0xAB);
+        if (!xc.open(few, few, kExperts, 4096, err)) { std::printf("open failed: %s\n", err.c_str()); ++bad; }
+        else {
+            xc.set_per_layer_admission(true);
+            int admitted = 0, refused = 0;
+            for (int l = 0; l < few; ++l) {
+                const int32_t s = xc.admit(l, 0);
+                if (s == kNotResident) { ++refused; continue; }
+                if (!xc.fill_slot_blocking(s, blob.data(), err, 4096)) { std::printf("fill: %s\n", err.c_str()); ++bad; break; }
+                ++admitted;
+            }
+            std::printf("admitted %d, refused %d (q=%d, last layer owns all %d)\n", admitted, refused, few / few == 1 ? 1 : 0, few);
+            if (admitted > few || admitted + refused != few) ++bad;
+        }
+    }
+
+    std::printf("== 5. duplicate admit maps to the same slot ==\n");
+    {
+        ExpertCache xc;
+        std::string err;
+        std::vector<uint8_t> blob((size_t) 2048, 0x5A);
+        if (!xc.open(4, 2, kExperts, 2048, err)) { std::printf("open failed: %s\n", err.c_str()); ++bad; }
+        else {
+            const int32_t a = xc.admit(0, 3), b = xc.admit(0, 3);
+            std::printf("first=%d second=%d %s\n", a, b, a == b ? "SAME" : "DIFFERENT");
+            if (a == kNotResident || a != b) ++bad;
+            else {
+                if (!xc.fill_slot_blocking(a, blob.data(), err, 2048) ||
+                    !xc.fill_slot_blocking(b, blob.data(), err, 2048) ||
+                    !xc.verify_slot(a, blob.data(), err, 2048)) { std::printf("refill/verify: %s\n", err.c_str()); ++bad; }
+            }
+        }
+    }
+
+    std::printf("== 6. bytes > blob_ is refused, not truncated ==\n");
+    {
+        ExpertCache xc;
+        std::string err;
+        std::vector<uint8_t> blob((size_t) 8192, 0);
+        if (!xc.open(4, 2, kExperts, 2048, err)) { std::printf("open failed: %s\n", err.c_str()); ++bad; }
+        else {
+            const int32_t s = xc.admit(0, 0);
+            const bool ok = xc.fill_slot_blocking(s, blob.data(), err, 4096);   // 4096 > blob_ 2048
+            std::printf("fill(4096 into 2048 slots) -> %s: %s\n", ok ? "ACCEPTED (WRONG)" : "refused", err.c_str());
+            if (ok) ++bad;
+        }
+    }
+
+    std::printf("== 7. readback rejects oversized/null input and detects corruption ==\n");
+    {
+        ExpertCache xc;
+        std::string err;
+        std::vector<uint8_t> blob(4096, 0x5A);
+        if (!xc.open(4, 2, kExperts, 2048, err)) { std::printf("open failed: %s\n", err.c_str()); ++bad; }
+        else {
+            const int32_t slot = xc.admit(0, 0);
+            if (!xc.fill_slot_blocking(slot, blob.data(), err, 2048)) ++bad;
+            const bool oversized = xc.verify_slot(slot, blob.data(), err, 4096);
+            const bool null_source = xc.verify_slot(slot, nullptr, err, 2048);
+            blob[17] ^= 1;
+            const bool corrupt = xc.verify_slot(slot, blob.data(), err, 2048);
+            std::printf("oversized=%s null=%s corruption=%s\n", oversized ? "WRONG" : "refused",
+                        null_source ? "WRONG" : "refused", corrupt ? "MISSED" : "detected");
+            if (oversized || null_source || corrupt) ++bad;
+        }
+    }
+    std::printf(bad == 0 ? "SIZED-CACHE TEST: PASS\n" : "SIZED-CACHE TEST: %d section(s) wrong\n", bad);
+    return bad == 0 ? 0 : 1;
+}
