@@ -0,0 +1,282 @@
+"""Offline shutdown lifecycle tests; no production port, real model, or GPU is used."""
+from __future__ import annotations
+
+import json
+import os
+import socket
+import subprocess
+import sys
+import threading
+import time
+import unittest
+import urllib.error
+import urllib.request
+from pathlib import Path
+from types import SimpleNamespace
+from unittest import mock
+
+from serve.frontend import ChatTemplate
+from serve import server as srv
+
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+class RestartTrackingEngine(srv.MockEngine):
+    def __init__(self, tokenizer):
+        super().__init__(tokenizer, "hello", max_context=4096)
+        self.restart_count = 0
+        self.is_alive = True
+
+    def alive(self):
+        return self.is_alive
+
+    def restart(self):
+        self.restart_count += 1
+        self.is_alive = True
+
+
+class EndpointShutdownTests(unittest.TestCase):
+    def setUp(self):
+        self.tok = srv.ByteTokenizer()
+        self.engine = RestartTrackingEngine(self.tok)
+        self.svc = srv.Service(self.engine, self.tok,
+                               ChatTemplate(ROOT / "serve" / "chat_template.jinja"),
+                               model_name="shutdown-test")
+        self.svc.api_key = "shutdown-test-key"
+        self.httpd = srv.Server(("127.0.0.1", 0), srv.make_handler(self.svc))
+        self.thread = threading.Thread(target=self.httpd.serve_forever, daemon=True)
+        self.thread.start()
+        self.base = f"http://127.0.0.1:{self.httpd.server_address[1]}"
+        self.origin = self.base
+
+    def tearDown(self):
+        if self.thread.is_alive():
+            self.httpd.shutdown()
+        self.httpd.server_close()
+        self.thread.join(timeout=3)
+
+    def post(self, path, *, headers=None, body=None):
+        payload = json.dumps({} if body is None else body).encode("utf-8")
+        req = urllib.request.Request(self.base + path, data=payload,
+                                     headers=headers or {}, method="POST")
+        try:
+            with urllib.request.urlopen(req, timeout=3) as response:
+                raw = response.read()
+                return response.status, json.loads(raw) if raw else {}
+        except urllib.error.HTTPError as exc:
+            with exc:
+                raw = exc.read()
+                return exc.code, json.loads(raw) if raw else {}
+
+    def headers(self, *, key="shutdown-test-key", origin=None, content_type="application/json"):
+        value = {"Content-Type": content_type}
+        if key is not None:
+            value["Authorization"] = "Bearer " + key
+        if origin is not None:
+            value["Origin"] = origin
+        return value
+
+    def test_missing_and_wrong_auth_return_401_without_shutdown(self):
+        for key in (None, "wrong-key"):
+            with self.subTest(key_present=key is not None):
+                status, _ = self.post("/shutdown", headers=self.headers(key=key, origin=self.origin))
+                self.assertEqual(status, 401)
+                self.assertFalse(self.svc.shutdown_requested.is_set())
+
+    def test_foreign_origin_and_non_json_are_refused(self):
+        status, _ = self.post("/shutdown", headers=self.headers(origin="http://attacker.example"))
+        self.assertEqual(status, 403)
+        self.assertFalse(self.svc.shutdown_requested.is_set())
+
+        status, _ = self.post("/shutdown", headers=self.headers(origin=self.origin,
+                                                                content_type="text/plain"))
+        self.assertEqual(status, 415)
+        self.assertFalse(self.svc.shutdown_requested.is_set())
+
+    def test_authorized_same_origin_shutdown_is_accepted_and_idempotent(self):
+        headers = self.headers(origin=self.origin)
+        status, body = self.post("/shutdown", headers=headers)
+        self.assertEqual((status, body), (202, {"status": "stopping"}))
+        self.assertTrue(self.svc.shutdown_requested.is_set())
+
+        status, body = self.post("/shutdown", headers=headers)
+        self.assertEqual((status, body), (202, {"status": "stopping"}))
+        self.assertTrue(self.svc.shutdown_requested.is_set())
+
+    def test_shutdown_rejects_load_and_chat_without_restarting_engine(self):
+        self.engine.is_alive = False
+        self.svc.shutdown_requested.set()
+        status, _ = self.post("/load", headers=self.headers(origin=self.origin))
+        self.assertEqual(status, 503)
+        status, _ = self.post("/v1/chat/completions", headers=self.headers(origin=self.origin), body={
+            "model": "shutdown-test", "messages": [{"role": "user", "content": "hello"}],
+            "max_tokens": 8,
+        })
+        self.assertEqual(status, 503)
+        self.assertEqual(self.engine.restart_count, 0)
+        self.assertFalse(self.engine.is_alive)
+
+    def test_generation_observes_request_cancellation(self):
+        entered = threading.Event()
+        self.engine.last_prompt = []
+
+        def generate(ids, max_new, sampling, cancel, embeddings=None):
+            yield self.tok.encode("x")[0]
+            entered.set()
+            cancel.wait(5)
+            self.assert_cancelled = cancel.is_set()
+
+        self.engine.generate = generate
+        client_cancel = threading.Event()
+        events = []
+        errors = []
+
+        def consume():
+            try:
+                events.extend(self.svc.run([], False, None, 32, {}, client_cancel))
+            except BaseException as exc:  # preserve worker failure for the test thread
+                errors.append(exc)
+
+        worker = threading.Thread(target=consume)
+        worker.start()
+        self.assertTrue(entered.wait(2), "mock generation did not start")
+        client_cancel.set()
+        worker.join(timeout=3)
+        self.assertFalse(worker.is_alive(), "generation ignored cancellation")
+        self.assertEqual(errors, [])
+        done = [payload for kind, payload in events if kind == "done"]
+        self.assertEqual(len(done), 1)
+        self.assertEqual(done[0]["finish"], "cancel")
+
+    def test_queued_generation_after_shutdown_cannot_restart_engine(self):
+        self.engine.is_alive = False
+        self.engine.unloaded = True
+        self.svc.fifo.acquire()
+        errors = []
+
+        def consume():
+            try:
+                list(self.svc.run([], False, None, 32, {}, None))
+            except BaseException as exc:
+                errors.append(exc)
+
+        worker = threading.Thread(target=consume)
+        worker.start()
+        try:
+            deadline = time.monotonic() + 2
+            while self.svc.status["queued"] != 1 and time.monotonic() < deadline:
+                time.sleep(0.005)
+            self.assertEqual(self.svc.status["queued"], 1, "request did not queue behind the active slot")
+            self.svc.shutdown_requested.set()
+        finally:
+            self.svc.fifo.release()
+        worker.join(timeout=3)
+        self.assertFalse(worker.is_alive())
+        self.assertEqual(len(errors), 1)
+        self.assertIsInstance(errors[0], srv.ServiceStopping)
+        self.assertEqual(self.engine.restart_count, 0)
+        self.assertEqual(self.svc.status["queued"], 0)
+
+
+class CancellationAndCleanupTests(unittest.TestCase):
+    def test_request_cancel_wait_and_both_cancel_sources(self):
+        shutdown = threading.Event()
+        client = threading.Event()
+        cancel = srv.RequestCancel(shutdown, client)
+        self.assertFalse(cancel.is_set())
+        self.assertFalse(cancel.wait(0.02))
+        client.set()
+        self.assertTrue(cancel.wait(0.2))
+
+        shutdown2 = threading.Event()
+        cancel2 = srv.RequestCancel(shutdown2)
+        shutdown2.set()
+        self.assertTrue(cancel2.is_set())
+        self.assertTrue(cancel2.wait(0.2))
+
+    def test_close_service_closes_only_owned_engine_vision_and_http(self):
+        class Child:
+            def __init__(self):
+                self.close = mock.Mock()
+                self.proc = SimpleNamespace(kill=mock.Mock(), wait=mock.Mock())
+
+        engine, vision, mcp, unrelated = Child(), Child(), Child(), Child()
+        svc = SimpleNamespace(shutdown_requested=threading.Event(), fifo=threading.Lock(),
+                              engine=engine, vision=vision, mcp=mcp)
+        httpd = SimpleNamespace(shutdown=mock.Mock(), server_close=mock.Mock())
+        srv.close_service(httpd, svc)
+
+        self.assertTrue(svc.shutdown_requested.is_set())
+        for child in (engine, vision, mcp):
+            child.close.assert_called_once_with()
+            child.proc.kill.assert_not_called()
+            child.proc.wait.assert_not_called()
+        unrelated.close.assert_not_called()
+        unrelated.proc.kill.assert_not_called()
+        httpd.shutdown.assert_called_once_with()
+        httpd.server_close.assert_called_once_with()
+
+
+@unittest.skipUnless(os.name == "nt", "uses Windows CREATE_NO_WINDOW for an isolated mock server")
+class MainProcessShutdownTests(unittest.TestCase):
+    def test_main_post_shutdown_exits_and_closes_random_port(self):
+        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as reservation:
+            reservation.bind(("127.0.0.1", 0))
+            port = reservation.getsockname()[1]
+
+        # Run the real server main loop and HTTP stack with MockEngine. Disable
+        # telemetry in this child so this test never touches NVML or a GPU.
+        child_script = (
+            "import serve.server as s; "
+            "s.Service.start_telemetry = lambda self: None; "
+            "raise SystemExit(s.main())"
+        )
+        command = [sys.executable, "-c", child_script, "--engine", "mock", "--host", "127.0.0.1",
+                   "--port", str(port), "--api-key", "shutdown-child-key"]
+        proc = subprocess.Popen(command, cwd=ROOT, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
+                                creationflags=subprocess.CREATE_NO_WINDOW)
+        base = f"http://127.0.0.1:{port}"
+        try:
+            deadline = time.monotonic() + 15
+            ready = False
+            last_error = None
+            while time.monotonic() < deadline and proc.poll() is None:
+                try:
+                    with urllib.request.urlopen(base + "/health", timeout=0.5) as response:
+                        health = json.loads(response.read())
+                    ready = health.get("status") == "ok"
+                    if ready:
+                        break
+                except (OSError, ValueError) as exc:
+                    last_error = exc
+                    time.sleep(0.05)
+            if not ready:
+                output = proc.stdout.read().decode("utf-8", "replace") if proc.poll() is not None else ""
+                self.fail(f"mock main did not become ready: {last_error}; exit={proc.poll()}; {output[-1000:]}")
+
+            req = urllib.request.Request(base + "/shutdown", data=b"{}", method="POST", headers={
+                "Authorization": "Bearer shutdown-child-key",
+                "Content-Type": "application/json",
+                "Origin": base,
+            })
+            with urllib.request.urlopen(req, timeout=3) as response:
+                self.assertEqual(response.status, 202)
+                self.assertEqual(json.loads(response.read()), {"status": "stopping"})
+            self.assertEqual(proc.wait(timeout=10), 0)
+            with self.assertRaises(OSError):
+                socket.create_connection(("127.0.0.1", port), timeout=0.5)
+        finally:
+            if proc.poll() is None:
+                proc.terminate()
+                try:
+                    proc.wait(timeout=3)
+                except subprocess.TimeoutExpired:
+                    proc.kill()
+                    proc.wait(timeout=3)
+            if proc.stdout:
+                proc.stdout.close()
+
+
+if __name__ == "__main__":
+    unittest.main()

diff --git a/serve/test_token_usage.py b/serve/test_token_usage.py
new file mode 100644
index 0000000..de11e73
--- /dev/null
+++ b/serve/test_token_usage.py
@@ -0,0 +1,108 @@
+"""Persistence, day boundaries and service accounting, without production models."""
+from datetime import datetime, timezone
+from pathlib import Path
+import sqlite3
+import tempfile
+import threading
+import unittest
+from unittest.mock import patch
+
+from serve.token_usage import TokenUsage
+from serve.server import ByteTokenizer, MockEngine, Service
+from serve.frontend import ChatTemplate
+
+
+def stamp(value):
+    return datetime.fromisoformat(value).replace(tzinfo=timezone.utc).timestamp()
+
+
+class TokenUsageTests(unittest.TestCase):
+    def test_restart_and_metrics_do_not_double_count(self):
+        with tempfile.TemporaryDirectory() as td:
+            path = Path(td) / 'tokens.sqlite3'
+            ledger = TokenUsage(path, now=stamp('2026-10-04T13:00:00'))
+            ledger.record(100, 40, 25, at=stamp('2026-10-04T13:01:00'))
+            for _ in range(3):
+                self.assertEqual(ledger.snapshot({}, now=stamp('2026-10-04T13:02:00'))['all_time']['requests'], 1)
+            restored = TokenUsage(path)
+            row = restored.snapshot({'requests': 0}, now=stamp('2026-10-04T13:05:00'))
+            self.assertTrue(row['persistent'])
+            self.assertEqual(row['session']['requests'], 0)
+            self.assertEqual(row['today']['prompt_tokens'], 100)
+            self.assertEqual(row['all_time']['reused'], 40)
+            restored.record(30, 0, 10, at=stamp('2026-10-04T13:06:00'))
+            final = TokenUsage(path).snapshot({}, now=stamp('2026-10-04T13:07:00'))
+            self.assertEqual(final['all_time']['requests'], 2)
+            self.assertEqual(final['all_time']['output_tokens'], 35)
+
+    def test_beijing_midnight_and_empty_day(self):
+        ledger = TokenUsage(now=stamp('2026-10-04T15:00:00'))
+        ledger.record(10, 0, 5, at=stamp('2026-10-04T15:59:59'))
+        ledger.record(20, 10, 8, at=stamp('2026-10-04T16:00:00'))
+        now = ledger.snapshot({}, now=stamp('2026-10-04T16:01:00'))
+        self.assertEqual(now['today']['date'], '2026-10-05')
+        self.assertEqual(now['today']['requests'], 1)
+        self.assertEqual(now['today']['prompt_tokens'], 20)
+        self.assertEqual(now['all_time']['requests'], 2)
+        self.assertEqual(ledger.snapshot({}, now=stamp('2026-10-05T16:00:00'))['today']['requests'], 0)
+
+    def test_invalid_database_is_preserved_and_reported(self):
+        with tempfile.TemporaryDirectory() as td:
+            path = Path(td) / 'tokens.sqlite3'
+            path.write_bytes(b'existing invalid file')
+            ledger = TokenUsage(path)
+            ledger.record(10, None, 2)
+            row = ledger.snapshot({})
+            self.assertFalse(row['persistent'])
+            self.assertTrue(row['persistence_error'])
+            self.assertEqual(path.read_bytes(), b'existing invalid file')
+            self.assertIsNone(row['all_time'])
+            self.assertIsNone(row['today'])  # unreadable history is not a fabricated zero
+
+    def test_failed_write_recovery_across_midnight(self):
+        with tempfile.TemporaryDirectory() as td:
+            path = Path(td) / 'tokens.sqlite3'
+            ledger = TokenUsage(path)
+            with patch('serve.token_usage.sqlite3.connect', side_effect=sqlite3.OperationalError('disk unavailable')):
+                ledger.record(100, 30, 20, at=stamp('2026-10-04T15:59:59'))
+            self.assertTrue(ledger.snapshot({})['persistence_error'])
+            ledger.record(50, 5, 10, at=stamp('2026-10-04T16:00:01'))
+            restored = TokenUsage(path)
+            today = restored.snapshot({}, now=stamp('2026-10-04T16:00:01'))
+            yesterday = restored.snapshot({}, now=stamp('2026-10-04T15:59:59'))
+            self.assertTrue(today['persistent'])
+            self.assertEqual(today['today']['requests'], 1)
