+def close_service(httpd, svc):
+    """Close this server and its own children, never other model services."""
+    svc.shutdown_requested.set()
+    acquired = svc.fifo.acquire(timeout=15)
+    try:
+        for child in (svc.engine, svc.vision, svc.mcp):
+            if child is None:
+                continue
+            try:
+                if not acquired and getattr(child, "proc", None) is not None:
+                    # A prompt/encoder that cannot cancel must not stall shutdown.
+                    child.proc.kill()
+                    child.proc.wait(timeout=10)
+                close = getattr(child, "close", None)
+                if close:
+                    close()
+            except Exception as exc:
+                print(f"[strata] cleanup {type(child).__name__}: {type(exc).__name__}", flush=True)
+    finally:
+        if acquired:
+            svc.fifo.release()
+        # The web page stays reachable with shutting_down=true until cleanup is
+        # finished, so it can distinguish accepted from actually offline.
+        httpd.shutdown()
+        httpd.server_close()
 
 
