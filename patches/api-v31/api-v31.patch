+def aggregate_segments(prompt_tokens: int, segments: list[dict], injected: int) -> dict:
+    """Cumulative engine clocks. Only the initial GEN's reused tokens belong to the client's input cache.
+    Unknown final clocks (e.g. engine death) invalidate throughput rather than reusing the previous DONE."""
+    complete = bool(segments) and all(s["done"] is not None and s["done"].get("prompt_ms") is not None
+                                      and s["done"].get("decode_ms") is not None for s in segments)
+    first = (segments[0]["done"] or {}) if segments else {}
+    initial_reused = min(prompt_tokens, max(0, int(first.get("reused") or 0)))
+    clocks = [s["done"] for s in segments if s["done"] is not None]
+    continuation_read, continuation_reused = 0, 0
+    for seg in segments[1:]:
+        reused = min(seg["prompt_tokens"], max(0, int((seg["done"] or {}).get("reused") or 0)))
+        continuation_reused += reused
+        continuation_read += seg["prompt_tokens"] - reused
+    out = {"reused": initial_reused, "generated": sum(int(d.get("generated") or 0) for d in clocks) if complete else None,
+           "prompt_ms": sum(float(d.get("prompt_ms") or 0) for d in clocks),
+           "decode_ms": sum(float(d.get("decode_ms") or 0) for d in clocks),
+           "continuation_prompt_tokens": continuation_read, "continuation_reused": continuation_reused,
+           "generation_segments": len(segments), "injected_tokens": injected, "timings_complete": complete,
+           "generation_segment_details": [
+               {"prompt_tokens": s["prompt_tokens"], "received_tokens": s["received"],
+                "engine_tokens": (s["done"] or {}).get("generated"),
+                "prompt_ms": (s["done"] or {}).get("prompt_ms"),
+                "decode_ms": (s["done"] or {}).get("decode_ms"),
+                "reused": min(s["prompt_tokens"], max(0, int((s["done"] or {}).get("reused") or 0))),
+                "done_received": s["done"] is not None} for s in segments]}
+    for key in ("hits", "lookups", "ram_blobs", "file_blobs", "file_mb", "drafts_offered", "drafts_accepted"):
+        if clocks and all(d.get(key) is not None for d in clocks):
+            out[key] = sum(d[key] for d in clocks)
+    return out
