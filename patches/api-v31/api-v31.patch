 class GpuBusy(RuntimeError):
     """The model is unloaded and the GPU has less free VRAM than min_free_vram_mib: something else (a game, another
     model server) is using it, so the engine is not started into the little that is left."""
+
+
+class ServiceStopping(GpuBusy):
+    """Shutdown has started; no request may restart the resident engine."""
+
+
+class RequestCancel:
+    """A client cancellation combined with shutdown, also during MCP calls."""
+    def __init__(self, shutdown, client=None):
+        self.shutdown = shutdown
+        self.client = client if client is not None else threading.Event()
+
+    def set(self):
+        self.client.set()
+
+    def is_set(self):
+        return self.shutdown.is_set() or self.client.is_set()
+
+    def wait(self, timeout=None):
+        deadline = None if timeout is None else time.monotonic() + timeout
+        while not self.is_set():
+            left = .1 if deadline is None else min(.1, deadline - time.monotonic())
+            if left <= 0:
+                return self.is_set()
+            self.client.wait(left)
+        return True
 
 
