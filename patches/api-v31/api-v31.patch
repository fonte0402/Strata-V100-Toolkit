new file mode 100644
index 0000000..af17614
--- /dev/null
+++ b/serve/test_generation_accounting.py
@@ -0,0 +1,143 @@
+"""Request accounting across budget continuations, drained stops and failed clocks (no GPU)."""
+import json
+import tempfile
+import threading
+import unittest
+from pathlib import Path
+
+from serve.frontend import ChatTemplate
+from serve.server import (ByteTokenizer, EngineDied, REASONING_WRAP_UP, Service,
+                          aggregate_segments, request_timings)
+from serve.test_server import ThinkingEngine
+
+
+class SegmentedEngine(ThinkingEngine):
+    def __init__(self, tok, failure=None):
+        super().__init__(tok)
+        self.last = {"generated": 999, "reused": 999, "prompt_ms": 999, "decode_ms": 999}
+        self.failure = failure
+
+    def generate(self, ids, max_new, sampling, cancel, embeddings=None):
+        continuation = bool(self.prompts)
+        count = 0
+        failed = False
+        try:
+            for token in super().generate(ids, max_new, sampling, cancel, embeddings):
+                count += 1
+                yield token
+                if continuation and self.failure == "death" and count == 2:
+                    failed = True
+                    raise EngineDied("synthetic missing DONE")
+        finally:
+            if not failed:
+                # Deliberately different rates: final pass alone must not be the request's rate.
+                self.last = {"generated": count, "prompt_tokens": len(ids),
+                             "reused": len(ids) - 3 if continuation else 5,
+                             "prompt_ms": 30.0 if continuation else 100.0,
+                             "decode_ms": count * (10.0 if continuation else 20.0),
+                             "drafts_offered": count * 2, "drafts_accepted": count,
+                             "hits": count * 9, "lookups": count * 10}
+
+
+class GenerationAccounting(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.tok = ByteTokenizer()
+        self.engine = SegmentedEngine(self.tok)
+        self.svc = Service(self.engine, self.tok,
+                           ChatTemplate(Path(__file__).with_name("chat_template.jinja")),
+                           usage_db=Path(self.tmp.name) / "usage.sqlite3")
+        self.ids = self.tok.encode("p" * 80)
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def run_request(self, budget=20, cancel=None):
+        events = list(self.svc.run(self.ids, True, None, 400,
+                                  {"reasoning_budget_tokens": budget}, cancel or threading.Event()))
+        return next(value for kind, value in events if kind == "done")
+
+    def test_budget_totals_two_clocks_but_only_initial_input_cache(self):
+        done = self.run_request()
+        wrap = len(self.tok.encode(REASONING_WRAP_UP, parse_special=True))
+        actual = 20 + len(self.engine.ANSWER) + 1
+        t = done["timings"]
+        self.assertEqual(done["completion_tokens"], actual + wrap)
+        self.assertEqual(done["reused"], 5)
+        self.assertEqual(t["generation_segments"], 2)
+        self.assertEqual(t["engine_predicted_n"], actual)
+        self.assertEqual(t["injected_tokens"], wrap)
+        self.assertEqual(t["predicted_ms"], 20 * 20 + (actual - 20) * 10)
+        self.assertEqual(t["prompt_ms"], 130)
+        self.assertEqual(sum(s["engine_tokens"] for s in t["generation_segment_details"]), actual)
+        self.assertEqual(sum(s["decode_ms"] for s in t["generation_segment_details"]), t["predicted_ms"])
+        self.assertEqual((t["initial_prompt_n"], t["continuation_prompt_n"]), (75, 3))
+        self.assertEqual(t["prompt_n"], 78)
+        self.assertAlmostEqual(t["predicted_per_second"], actual / (t["predicted_ms"] / 1000), delta=.1)
+        self.assertEqual((t["draft_n"], t["draft_n_accepted"]), (actual * 2, actual))
+        row = self.svc.metrics()["requests"][-1]
+        self.assertEqual(row["engine_generated"], actual)
+        self.assertEqual(row["reused"], 5)
+        self.assertTrue(row["timings_complete"])
+        for key in ("session", "today", "all_time"):
+            usage = self.svc.metrics()["token_usage"][key]
+            self.assertEqual((usage["prompt_tokens"], usage["reused"], usage["output_tokens"]),
+                             (80, 5, actual + wrap))
+
+    def test_natural_thought_single_pass_has_no_injection(self):
+        t = self.run_request(budget=10000)["timings"]
+        self.assertEqual((t["generation_segments"], t["injected_tokens"]), (1, 0))
+        self.assertEqual((t["cache_n"], t["prompt_n"]), (5, 75))
+        self.assertEqual(t["predicted_n"], t["engine_predicted_n"])
+
+    def test_death_after_first_pass_does_not_reuse_its_done_as_final_clock(self):
+        self.engine.failure = "death"
+        with self.assertRaises(EngineDied):
+            self.run_request()
+        row = self.svc.metrics()["requests"][-1]
+        self.assertEqual(row["generation_segments"], 2)
+        self.assertFalse(row["timings_complete"])
+        self.assertEqual(row["finish"], "error")
+        self.assertIsNone(row["engine_generated"])
+        self.assertIsNone(row["decode_tok_s"])
+        self.assertIsNone(self.svc.last_timings)
+        self.assertEqual(row["reused"], 5)
+
+    def test_disconnect_drains_and_accounts_partial_current_pass(self):
+        gen = self.svc.run(self.ids, True, None, 400, {"reasoning_budget_tokens": 20}, threading.Event())
+        for kind, value in gen:
+            if kind == "event":
+                break
+        gen.close()
+        row = self.svc.metrics()["requests"][-1]
+        self.assertEqual(row["finish"], "disconnect")
+        self.assertEqual(row["generation_segments"], 1)
+        self.assertTrue(row["timings_complete"])
+        self.assertLess(row["output_tokens"], 400)
+        self.assertEqual(row["injected_tokens"], 0)
+
+    def test_cancel_does_not_start_budget_continuation(self):
+        cancel = threading.Event()
+        gen = self.svc.run(self.ids, True, None, 400, {"reasoning_budget_tokens": 20}, cancel)
+        for kind, value in gen:
+            if kind == "event":
+                cancel.set()
+                break
+        remaining = list(gen)
+        done = next(value for kind, value in remaining if kind == "done")
+        self.assertEqual(done["finish"], "cancel")
+        self.assertEqual(done["timings"]["generation_segments"], 1)
+        self.assertEqual(len(self.engine.prompts), 1)
+
+    def test_aggregate_clamps_cache_and_keeps_zero_decode_count(self):
+        result = aggregate_segments(10, [{"prompt_tokens": 10, "received": 0,
+                                         "done": {"prompt_ms": 2, "decode_ms": 3,
+                                                  "generated": 0, "reused": 999}}], 0)
+        timing = request_timings(10, 7, result)
+        self.assertEqual(timing["cache_n"], 10)
+        self.assertIsNone(timing["predicted_per_second"])
+        self.assertEqual(timing["engine_predicted_n"], 0)
+
+
+if __name__ == "__main__":
+    unittest.main()

