diff --git a/serve/token_usage.py b/serve/token_usage.py
new file mode 100644
index 0000000..af60d49
--- /dev/null
+++ b/serve/token_usage.py
@@ -0,0 +1,91 @@
+"""Local token counters, shared by managed Profiles; no prompts or credentials stored."""
+from contextlib import closing
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+import sqlite3
+import threading
+import time
+
+FIELDS = ('requests', 'prompt_tokens', 'reused', 'output_tokens')
+BEIJING = timezone(timedelta(hours=8))
+
+
+def day_of(timestamp):
+    return datetime.fromtimestamp(timestamp, BEIJING).date().isoformat()
+
+
+def zero():
+    return dict.fromkeys(FIELDS, 0)
+
+
+class TokenUsage:
+    """One managed server writer; atomic SQLite commits and inexpensive memory snapshots.
+
+    Requests are attributed to their completion date in Beijing time. Polling does
+    not write or increment counters. After a write failure, the next successful
+    write stores the full pending aggregates without counting a request twice.
+    """
+    def __init__(self, path=None, *, now=None):
+        self.path = Path(path) if path else None
+        self.lock = threading.Lock()
+        self.since = time.time() if now is None else now
+        self.total = zero()
+        self.days = {}
+        self.pending = set()
+        self.error = None
+        self.blocked = False
+        if self.path:
+            try:
+                self.path.parent.mkdir(parents=True, exist_ok=True)
+                with closing(sqlite3.connect(self.path, timeout=2)) as db:
+                    with db:
+                        db.execute('CREATE TABLE IF NOT EXISTS total (id INTEGER PRIMARY KEY CHECK(id=1), since REAL NOT NULL, requests INTEGER NOT NULL, prompt_tokens INTEGER NOT NULL, reused INTEGER NOT NULL, output_tokens INTEGER NOT NULL)')
+                        db.execute('CREATE TABLE IF NOT EXISTS days (date TEXT PRIMARY KEY, requests INTEGER NOT NULL, prompt_tokens INTEGER NOT NULL, reused INTEGER NOT NULL, output_tokens INTEGER NOT NULL)')
+                        row = db.execute('SELECT since,requests,prompt_tokens,reused,output_tokens FROM total WHERE id=1').fetchone()
+                        if row:
+                            self.since = row[0]
+                            self.total = dict(zip(FIELDS, row[1:]))
+                        else:
+                            db.execute('INSERT INTO total VALUES (1,?,0,0,0,0)', (self.since,))
+                        self.days = {r[0]: dict(zip(FIELDS, r[1:])) for r in db.execute('SELECT date,requests,prompt_tokens,reused,output_tokens FROM days')}
+                for counts in [self.total, *self.days.values()]:
+                    if any(type(v) is not int or v < 0 for v in counts.values()) or counts['reused'] > counts['prompt_tokens']:
+                        raise ValueError('Invalid stored token counters')
+            except (OSError, sqlite3.Error, ValueError) as exc:
+                self.total, self.days = zero(), {}
+                self.blocked = True  # preserve unreadable database; do not replace it
+                self.error = str(exc)
+
+    def record(self, prompt_tokens, reused, output_tokens, *, at=None):
+        counts = {'requests': 1, 'prompt_tokens': max(0, int(prompt_tokens)),
+                  'reused': max(0, int(reused or 0)), 'output_tokens': max(0, int(output_tokens))}
+        counts['reused'] = min(counts['reused'], counts['prompt_tokens'])
+        date = day_of(time.time() if at is None else at)
+        with self.lock:
+            today = self.days.setdefault(date, zero())
+            for key, value in counts.items():
+                self.total[key] += value
+                today[key] += value
+            self.pending.add(date)
+            if not self.path or self.blocked:
+                return
+            try:
+                with closing(sqlite3.connect(self.path, timeout=2)) as db:
+                    with db:
+                        db.execute('UPDATE total SET since=?,requests=?,prompt_tokens=?,reused=?,output_tokens=? WHERE id=1',
+                                   (self.since, *(self.total[k] for k in FIELDS)))
+                        db.executemany('INSERT OR REPLACE INTO days VALUES (?,?,?,?,?)',
+                                       [(date, *(self.days[date][k] for k in FIELDS)) for date in sorted(self.pending)])
+                self.pending.clear()
+                self.error = None
+            except (OSError, sqlite3.Error) as exc:
+                self.error = str(exc)  # generation still succeeds; Monitor shows failure
+
+    def snapshot(self, session, *, now=None):
+        date = day_of(time.time() if now is None else now)
+        with self.lock:
+            return {'session': dict(session),
+                    'today': None if self.blocked else {'date': date, **self.days.get(date, zero())},
+                    'all_time': None if self.blocked else {'since': self.since, **self.total}, 'timezone': 'Asia/Shanghai',
+                    'persistent': bool(self.path) and not self.error,
+                    'persistence_error': self.error}

